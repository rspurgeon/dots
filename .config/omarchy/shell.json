{
  "version": 1,
  "idle": {
    "screensaver": 86400,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "rspurgeon.pitch-agents",
    "layout": {
      "left": [
        {
          "id": "rspurgeon.workspaces",
          "monitorWorkspaces": {
            "HDMI-A-1": [1, 2, 3, 4, 5, 6],
            "DP-2": [7, 8, 9]
          }
        }
      ],
      "center": [
        {
          "id": "rspurgeon.pitch-agents"
        }
      ],
      "right": [
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd MMM dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy"
        }
      ]
    }
  },
  "plugins": []
}
